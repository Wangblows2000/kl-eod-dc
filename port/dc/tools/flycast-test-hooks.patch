+static FILE *dumpFile;
+static bool dumpChecked;
+
 void WriteSample(s16 r, s16 l)
 {
+	if (!dumpChecked)
+	{
+		dumpChecked = true;
+		const char *path = getenv("FC_AUDIO_DUMP");	// raw 44.1 kHz s16 stereo (L, R), for tests
+		if (path != nullptr)
+			dumpFile = fopen(path, "wb");
+	}
+	if (dumpFile != nullptr)
+	{
+		s16 frame[2] = { l, r };
+		fwrite(frame, sizeof(frame), 1, dumpFile);
+		static u32 dumped;
+		if (++dumped % 4410 == 0)
+			fflush(dumpFile);
+	}
 	Buffer[writePtr].r = r * config::AudioVolume.dbPower();
 	Buffer[writePtr].l = l * config::AudioVolume.dbPower();
 
