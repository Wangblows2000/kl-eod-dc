+// Test hook (local patch): a serial line "FCDUMP <addr hex> <len hex>" from the guest writes that
+// range of main RAM to the file named by $FC_RAMDUMP, so a test build can hand over bulk data
+// without pushing it through the emulated serial port.
+static void ramdump_check(u8 data)
+{
+	static char line[64];
+	static int len;
+	if (data != '\n') {
+		if (len < (int)sizeof(line) - 1)
+			line[len++] = (char)data;
+		return;
+	}
+	line[len] = 0;
+	len = 0;
+	unsigned addr, size;
+	const char *path = getenv("FC_RAMDUMP");
+	if (path == nullptr || sscanf(line, "FCDUMP %x %x", &addr, &size) != 2)
+		return;
+	addr &= RAM_MASK;
+	if (size > RAM_SIZE - addr)
+		size = RAM_SIZE - addr;
+	FILE *f = fopen(path, "wb");
+	if (f != nullptr) {
+		fwrite(&mem_b[addr], 1, size, f);
+		fclose(f);
+		fprintf(stderr, "FCDUMP wrote %u bytes from %08x to %s\n", size, addr, path);
+	}
+}
+
 // SCIF SCFTDR2 - Transmit FIFO Data Register
 void SCIFSerialPort::SCFTDR2_write(u8 data)
 {
+	ramdump_check(data);
 	SCIF_LOG("serial out %02x %c fifo_sz %d", data, data == '\0' ? ' ' : data, (int)txFifo.size());
 	if (SCIF_SCFCR2.TFRST == 1)
 		return;
